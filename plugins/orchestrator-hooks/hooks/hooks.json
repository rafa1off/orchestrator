{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "P=\"${CLAUDE_PROJECT_DIR}/.claude/pipeline\"; rm -f \"$P/checker-findings.json\" \"$P/reviewer-findings.json\" \"$P/tester-findings.json\" \"$P/pre-compact-snapshot.md\" \"$P/write-log.tsv\" \"$P/identity-audit.jsonl\" \"$P\"/*/checker-findings.json \"$P\"/*/reviewer-findings.json \"$P\"/*/tester-findings.json 2>/dev/null; rm -rf \"$P/.starts\" 2>/dev/null; true"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "^orchestrator-agents:(checker|reviewer|tester|writer)$",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/subagent-start-stamp.sh\""
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/agent-identity-audit.sh\""
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "^orchestrator-agents:(checker|reviewer|tester)$",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/subagent-stop-findings-guard.sh\""
          }
        ]
      },
      {
        "matcher": "^orchestrator-agents:(checker|reviewer|tester|writer)$",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/subagent-stop-clear-stamp.sh\""
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/agent-identity-audit.sh\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/block-subagent-git-push.sh\""
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/block-nested-restricted-agents.sh\""
          }
        ]
      },
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/block-readonly-agent-writes.sh\""
          }
        ]
      },
      {
        "matcher": "Write|Edit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/agent-identity-audit.sh\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__.*__write_findings",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/post-tool-findings.sh\""
          }
        ]
      },
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/track-writer-overlap.sh\""
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "P=\"${CLAUDE_PROJECT_DIR}/.claude/pipeline\"; { printf '# Pipeline Snapshot — %s\\n' \"$(date -u +%Y-%m-%dT%H:%M:%SZ)\"; for f in checker-findings.json reviewer-findings.json tester-findings.json; do [ -f \"$P/$f\" ] && { printf '## %s\\n' \"$f\"; cat \"$P/$f\"; echo; }; done; } > \"$P/pre-compact-snapshot.md\" 2>/dev/null || true"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "P=\"${CLAUDE_PROJECT_DIR}/.claude/pipeline\"; L=\"$P/session-log.txt\"; mkdir -p \"$P\"; printf '%s session-end\\n' \"$(date -u +%Y-%m-%dT%H:%M:%SZ)\" >> \"$L\"; tail -n 500 \"$L\" > \"$L.tmp\" 2>/dev/null && mv \"$L.tmp\" \"$L\"; rm -f \"$P/checker-findings.json\" \"$P/reviewer-findings.json\" \"$P/tester-findings.json\" \"$P/pre-compact-snapshot.md\" \"$P/write-log.tsv\" \"$P/identity-audit.jsonl\" \"$P\"/*/checker-findings.json \"$P\"/*/reviewer-findings.json \"$P\"/*/tester-findings.json 2>/dev/null; rm -rf \"$P/.starts\" 2>/dev/null; true"
          }
        ]
      }
    ]
  }
}
