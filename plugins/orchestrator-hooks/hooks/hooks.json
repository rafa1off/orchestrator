{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "P=\"${CLAUDE_PROJECT_DIR}/.claude/pipeline\"; rm -f \"$P\"/checker-*-findings.json \"$P\"/reviewer-*-findings.json \"$P\"/tester-*-findings.json \"$P\"/reader-*-report.json \"$P\"/writer-*-report.json \"$P\"/thinker-*-report.json \"$P\"/researcher-*-report.json \"$P/pre-compact-snapshot.md\" \"$P/write-log.tsv\" \"$P/identity-audit.jsonl\" \"$P\"/*/checker-*-findings.json \"$P\"/*/reviewer-*-findings.json \"$P\"/*/tester-*-findings.json \"$P\"/*/reader-*-report.json \"$P\"/*/writer-*-report.json \"$P\"/*/thinker-*-report.json \"$P\"/*/researcher-*-report.json 2>/dev/null; rm -rf \"$P/.starts\" 2>/dev/null; true"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "^orchestrator-agents:(checker|reviewer|tester|writer)$",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/subagent-start-stamp.sh\""
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/agent-identity-audit.sh\""
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "^orchestrator-agents:(checker|reviewer|tester|reader|writer|thinker|researcher)$",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/subagent-stop-findings-guard.sh\""
          }
        ]
      },
      {
        "matcher": "^orchestrator-agents:(checker|reviewer|tester|writer)$",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/subagent-stop-clear-stamp.sh\""
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/agent-identity-audit.sh\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/block-subagent-git-push.sh\""
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/block-nested-restricted-agents.sh\""
          }
        ]
      },
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/block-readonly-agent-writes.sh\""
          }
        ]
      },
      {
        "matcher": "Write|Edit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/agent-identity-audit.sh\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__.*__(write_findings|write_report)",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/post-tool-findings.sh\""
          }
        ]
      },
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/track-writer-overlap.sh\""
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "P=\"${CLAUDE_PROJECT_DIR}/.claude/pipeline\"; { printf '# Pipeline Snapshot — %s\\n' \"$(date -u +%Y-%m-%dT%H:%M:%SZ)\"; for pair in checker:findings reviewer:findings tester:findings reader:report writer:report thinker:report researcher:report; do src=\"${pair%%:*}\"; kind=\"${pair##*:}\"; for f in \"$P/${src}-\"*\"-${kind}.json\"; do [ -f \"$f\" ] && { printf '## %s\\n' \"$(basename \"$f\")\"; cat \"$f\"; echo; }; done; done; } > \"$P/pre-compact-snapshot.md\" 2>/dev/null || true"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "P=\"${CLAUDE_PROJECT_DIR}/.claude/pipeline\"; L=\"$P/session-log.txt\"; mkdir -p \"$P\"; printf '%s session-end\\n' \"$(date -u +%Y-%m-%dT%H:%M:%SZ)\" >> \"$L\"; tail -n 500 \"$L\" > \"$L.tmp\" 2>/dev/null && mv \"$L.tmp\" \"$L\"; rm -f \"$P\"/checker-*-findings.json \"$P\"/reviewer-*-findings.json \"$P\"/tester-*-findings.json \"$P\"/reader-*-report.json \"$P\"/writer-*-report.json \"$P\"/thinker-*-report.json \"$P\"/researcher-*-report.json \"$P/pre-compact-snapshot.md\" \"$P/write-log.tsv\" \"$P/identity-audit.jsonl\" \"$P\"/*/checker-*-findings.json \"$P\"/*/reviewer-*-findings.json \"$P\"/*/tester-*-findings.json \"$P\"/*/reader-*-report.json \"$P\"/*/writer-*-report.json \"$P\"/*/thinker-*-report.json \"$P\"/*/researcher-*-report.json 2>/dev/null; rm -rf \"$P/.starts\" 2>/dev/null; true"
          }
        ]
      }
    ]
  }
}
